{
  "description": "36V DC Bench Power Supply — AC-DC2416 + XY-SK60X + IEC C14 combo, parametric enclosure",

  "_notes": {
    "sketch.rectangle.center": "corner = [center_x + half_w, center_y + half_h]  (absolute corner point, NOT half-dims)",
    "coordinates": "Origin centre of external bottom face. X=width±, Y=depth(front- rear+), Z=height(0 up)",
    "box_external_mm": "165 W × 178 D × 72.5 H (open-top box). Lid adds 2.5 mm = 75 mm total.",
    "front_face_Y": -89,
    "rear_face_Y": 89
  },

  "steps": [

    {"comment":"══ SECTION 1 · PARAMETERS ══"},

    {"command":"parameters.change","params":{"name":"enc_wi",   "expression":"160 mm"},"caption":"Internal width  160 mm"},
    {"command":"parameters.change","params":{"name":"enc_di",   "expression":"173 mm"},"caption":"Internal depth  173 mm"},
    {"command":"parameters.change","params":{"name":"enc_hi",   "expression":"70 mm"}, "caption":"Internal height  70 mm"},
    {"command":"parameters.change","params":{"name":"wall",     "expression":"2.5 mm"},"caption":"Wall thickness   2.5 mm"},
    {"command":"parameters.change","params":{"name":"standoff", "expression":"5 mm"},  "caption":"PCB standoff     5 mm"},
    {"command":"parameters.change","params":{"name":"acdc_hd",  "expression":"4 mm"},  "caption":"AC/DC hole Ø     4 mm"},

    {"comment":"══ SECTION 2 · BOX BODY ══"},

    {
      "command":"sketch.create",
      "params":{"plane":"XY","name":"BoxOutline"},
      "caption":"Enclosure footprint on XY plane","pause":0.8
    },
    {
      "command":"sketch.rectangle.center",
      "params":{"center":[0,0],"corner":[82.5,89]},
      "caption":"165 × 178 mm external footprint (corner = half-dims because centre = origin)"
    },
    {
      "command":"sketch.constraint.coincident",
      "params":{"a":"p5","b":"origin"},
      "caption":"Lock rectangle centre to origin"
    },
    {
      "command":"sketch.dimension",
      "params":{"entities":["l1"],"value":"enc_wi + wall * 2"},
      "caption":"Drive width = internal + 2 walls"
    },
    {
      "command":"sketch.dimension",
      "params":{"entities":["l2"],"value":"enc_di + wall * 2"},
      "caption":"Drive depth = internal + 2 walls"
    },
    {"command":"sketch.finish","params":{},"caption":"Finish box outline","pause":0.5},
    {
      "command":"solid.extrude",
      "params":{"distance":"enc_hi + wall","body_name":"Box"},
      "caption":"Extrude box 72.5 mm tall","pause":1.0
    },
    {
      "command":"solid.fillet",
      "params":{"edges":[[82.5,89,36],[-82.5,89,36],[-82.5,-89,36],[82.5,-89,36]],"radius":5},
      "caption":"Fillet 4 vertical corners 5 mm","pause":0.8
    },
    {
      "command":"solid.shell",
      "params":{"faces":[[0,0,72.5]],"thickness":"wall"},
      "caption":"Shell — open top face, 2.5 mm walls","pause":1.0
    },

    {"comment":"══ SECTION 3 · FRONT PANEL — CONTROLLER CUTOUT 81.6 × 40.6 mm ══"},
    {"comment":"Layout: [14.85] controller(81.6) [14.85] +/-(Ø12) [14.85] earth(Ø12) [14.85]"},
    {"comment":"Front face Y=−89. Plane: origin=[0,−89,0], x=[1,0,0], y=[0,0,1]"},
    {"comment":"sketch X = world X,  sketch Y = world Z"},
    {"comment":"Controller centre X = −82.5 + 14.85 + 40.8 = −26.85,  centre Z = 30.3"},
    {"comment":"half-w=40.8, half-h=20.3  →  corner = [−26.85+40.8, 30.3+20.3] = [13.95, 50.6]"},

    {
      "command":"sketch.create",
      "params":{"plane":{"origin":[0,-89,0],"x_dir":[1,0,0],"y_dir":[0,0,1]},"name":"CtrlCutout"},
      "caption":"Sketch on front face","pause":0.8
    },
    {
      "command":"sketch.rectangle.center",
      "params":{"center":[-26.85,30.3],"corner":[13.95,50.6]},
      "caption":"Controller cutout 81.6 × 40.6 mm, centre X=−26.85"
    },
    {"command":"sketch.finish","params":{},"pause":0.4},
    {
      "command":"solid.extrude",
      "params":{"through_all":true,"operation":"cut"},
      "caption":"Cut controller opening","pause":0.8
    },

    {"comment":"══ SECTION 4 · FRONT PANEL — BANANA SOCKETS 3 × Ø12 mm ══"},
    {"comment":"Two vertical columns, both centred at Z=30.3, 19 mm c/c spacing:"},
    {"comment":"  Col 1  X=34.8:  Minus (bottom) Z=20.8,  Plus  (top) Z=39.8"},
    {"comment":"  Col 2  X=61.65: Earth (bottom) Z=20.8,  Toggle(top) Z=39.8"},

    {
      "command":"sketch.create",
      "params":{"plane":{"origin":[0,-89,0],"x_dir":[1,0,0],"y_dir":[0,0,1]},"name":"Banana_Neg"},
      "caption":"Banana — Black (−) X=34.8  Z=20.8 (bottom of col 1)","pause":0.5
    },
    {"command":"sketch.circle","params":{"center":[34.8,20.8],"radius":6},"caption":"Ø12 mm — Minus"},
    {"command":"sketch.finish","params":{}},
    {"command":"solid.extrude","params":{"through_all":true,"operation":"cut"},"caption":"Cut Minus hole","pause":0.4},

    {
      "command":"sketch.create",
      "params":{"plane":{"origin":[0,-89,0],"x_dir":[1,0,0],"y_dir":[0,0,1]},"name":"Banana_Pos"},
      "caption":"Banana — Red (+) X=34.8  Z=39.8 (top of col 1)","pause":0.5
    },
    {"command":"sketch.circle","params":{"center":[34.8,39.8],"radius":6},"caption":"Ø12 mm — Plus"},
    {"command":"sketch.finish","params":{}},
    {"command":"solid.extrude","params":{"through_all":true,"operation":"cut"},"caption":"Cut Plus hole","pause":0.4},

    {
      "command":"sketch.create",
      "params":{"plane":{"origin":[0,-89,0],"x_dir":[1,0,0],"y_dir":[0,0,1]},"name":"Banana_Earth"},
      "caption":"Banana — Green (Earth) X=61.65  Z=20.8 (bottom of col 2)","pause":0.5
    },
    {"command":"sketch.circle","params":{"center":[61.65,20.8],"radius":6},"caption":"Ø12 mm — Earth"},
    {"command":"sketch.finish","params":{}},
    {"command":"solid.extrude","params":{"through_all":true,"operation":"cut"},"caption":"Cut Earth hole","pause":0.4},

    {"comment":"══ SECTION 5 · FRONT PANEL — TOGGLE SWITCH Ø6 mm ══"},
    {"comment":"Top of col 2: X=61.65, Z=39.8 (19 mm above Earth — same pattern as +/−)"},

    {
      "command":"sketch.create",
      "params":{"plane":{"origin":[0,-89,0],"x_dir":[1,0,0],"y_dir":[0,0,1]},"name":"ToggleHole"},
      "caption":"Toggle switch — X=61.65  Z=39.8 (top of col 2)","pause":0.5
    },
    {"command":"sketch.circle","params":{"center":[61.65,39.8],"radius":3},"caption":"Ø6 mm"},
    {"command":"sketch.finish","params":{}},
    {"command":"solid.extrude","params":{"through_all":true,"operation":"cut"},"caption":"Cut toggle hole","pause":0.5},

    {"comment":"══ SECTION 6 · REAR PANEL — IEC C14 COMBO 46.8 × 28.5 mm ══"},
    {"comment":"Rear face Y=+89. Plane: origin=[0,89,0], x=[1,0,0], y=[0,0,1]"},
    {"comment":"IEC centre: (0, 30.3)  corner = [0+23.4, 30.3+14.25] = [23.4, 44.55]"},

    {
      "command":"sketch.create",
      "params":{"plane":{"origin":[0,89,0],"x_dir":[1,0,0],"y_dir":[0,0,1]},"name":"IEC_Cutout"},
      "caption":"IEC C14 combo cutout on rear face","pause":0.8
    },
    {
      "command":"sketch.rectangle.center",
      "params":{"center":[0,30.3],"corner":[23.4,44.55]},
      "caption":"46.8 × 28.5 mm opening, centre Z=30.3"
    },
    {"command":"sketch.finish","params":{},"pause":0.4},
    {
      "command":"solid.extrude",
      "params":{"through_all":true,"operation":"cut"},
      "caption":"Cut IEC opening","pause":0.8
    },

    {"comment":"── IEC mounting holes 2 × Ø4.5 mm at X=±20, Z=44.3 ──"},
    {
      "command":"sketch.create",
      "params":{"plane":{"origin":[0,89,0],"x_dir":[1,0,0],"y_dir":[0,0,1]},"name":"IEC_Holes"},
      "caption":"IEC mount holes","pause":0.5
    },
    {"comment":"── Hole pattern 40×28 c/c centred on IEC centre (0, 30.3). Z=30.3±14=[16.3,44.3], X=±20 ──"},
    {"command":"sketch.circle","params":{"center":[-20,16.3],"radius":2.25},"caption":"Bottom-left hole Ø4.5 mm"},
    {"command":"sketch.circle","params":{"center":[ 20,16.3],"radius":2.25},"caption":"Bottom-right hole Ø4.5 mm"},
    {"command":"sketch.circle","params":{"center":[-20,44.3],"radius":2.25},"caption":"Top-left hole Ø4.5 mm"},
    {"command":"sketch.circle","params":{"center":[ 20,44.3],"radius":2.25},"caption":"Top-right hole Ø4.5 mm"},
    {"command":"sketch.finish","params":{}},
    {"command":"solid.extrude","params":{"through_all":true,"operation":"cut"},"caption":"Cut IEC mount holes","pause":0.5},

    {"comment":"══ SECTION 7 · BOTTOM — RUBBER FOOT HOLES 4 × Ø4 mm ══"},
    {"comment":"XY plane. Positions 10 mm inset from corners: X=±72.5, Y=±79"},

    {
      "command":"sketch.create",
      "params":{"plane":"XY","name":"FootHoles"},
      "caption":"Foot holes on bottom face","pause":0.5
    },
    {"command":"sketch.circle","params":{"center":[-72.5,-79],"radius":2},"caption":"Front-left"},
    {"command":"sketch.circle","params":{"center":[ 72.5,-79],"radius":2},"caption":"Front-right"},
    {"command":"sketch.circle","params":{"center":[-72.5, 79],"radius":2},"caption":"Rear-left"},
    {"command":"sketch.circle","params":{"center":[ 72.5, 79],"radius":2},"caption":"Rear-right"},
    {"command":"sketch.finish","params":{}},
    {"command":"solid.extrude","params":{"through_all":true,"operation":"cut"},"caption":"Cut foot holes","pause":0.6},

    {"comment":"══ SECTION 8 · BOTTOM — INTAKE VENT SLOTS (beside PCB, AC-input end) ══"},
    {"comment":"4 slots, 2 mm wide × 20 mm long. Centre X=±34.8 & ±37.8, Y=76"},
    {"comment":"corner = [centre_x + 1, centre_y + 10]"},

    {
      "command":"sketch.create",
      "params":{"plane":"XY","name":"VentIntake"},
      "caption":"Bottom intake vent slots","pause":0.5
    },
    {"command":"sketch.rectangle.center","params":{"center":[-34.8,76],"corner":[-33.8,86]},"caption":"Left slot 1"},
    {"command":"sketch.rectangle.center","params":{"center":[-37.8,76],"corner":[-36.8,86]},"caption":"Left slot 2"},
    {"command":"sketch.rectangle.center","params":{"center":[ 34.8,76],"corner":[ 35.8,86]},"caption":"Right slot 1"},
    {"command":"sketch.rectangle.center","params":{"center":[ 37.8,76],"corner":[ 38.8,86]},"caption":"Right slot 2"},
    {"command":"sketch.finish","params":{}},
    {"command":"solid.extrude","params":{"through_all":true,"operation":"cut"},"caption":"Cut intake slots","pause":0.8},

    {"comment":"══ SECTION 9 · AC-DC2416 MOUNTING BOSSES ══"},
    {"comment":"Hole pattern 105.25 × 56 mm. AC/DC centre at (0, 24). Boss X=±28, Y=±52.625 from Y=24"},

    {"command":"plastic.boss","params":{"position":[ 28, 76.6,2.5],"diameter":8,"height":5,"hole_diameter":4},"caption":"Boss — rear right","pause":0.3},
    {"command":"plastic.boss","params":{"position":[-28, 76.6,2.5],"diameter":8,"height":5,"hole_diameter":4},"caption":"Boss — rear left", "pause":0.3},
    {"command":"plastic.boss","params":{"position":[ 28,-28.6,2.5],"diameter":8,"height":5,"hole_diameter":4},"caption":"Boss — front right","pause":0.3},
    {"command":"plastic.boss","params":{"position":[-28,-28.6,2.5],"diameter":8,"height":5,"hole_diameter":4},"caption":"Boss — front left", "pause":0.3},

    {"comment":"══ SECTION 10 · LID BODY ══"},
    {"comment":"Sketched on plane at Z=72.5 (top rim of box). Extrude 2.5 mm UP → lid at Z=72.5 to 75"},
    {"comment":"If lid merges into Box body, export box, then create lid manually in a new document"},

    {
      "command":"sketch.create",
      "params":{"plane":{"origin":[0,0,72.5],"x_dir":[1,0,0],"y_dir":[0,1,0]},"name":"LidOutline"},
      "caption":"Lid panel at Z=72.5","pause":0.8
    },
    {
      "command":"sketch.rectangle.center",
      "params":{"center":[0,0],"corner":[82.5,89]},
      "caption":"Lid footprint 165 × 178 mm (same as box)"
    },
    {"command":"sketch.finish","params":{},"pause":0.5},
    {
      "command":"solid.extrude",
      "params":{"distance":2.5,"operation":"new_body","body_name":"Lid"},
      "caption":"Lid panel 2.5 mm thick","pause":1.0
    },

    {"comment":"══ SECTION 11 · LID — EXHAUST VENT SLOTS ══"},
    {"comment":"8 slots on top face Z=75. Beside PCB edges (X=±34.8, ±37.8)"},
    {"comment":"Heatsink zone: Y=−10.5 to +11.5 (centre Y=0.5)"},
    {"comment":"DC-output end: Y=−33.5 to −13.5 (centre Y=−23.5)"},
    {"comment":"corner = [centre_x + 1, centre_y + half_h]"},

    {
      "command":"sketch.create",
      "params":{"plane":{"origin":[0,0,75],"x_dir":[1,0,0],"y_dir":[0,1,0]},"name":"VentExhaust"},
      "caption":"Lid exhaust vents on top face Z=75","pause":0.5
    },
    {"comment":"── Heatsink zone slots (22 mm span, half=11) ──"},
    {"command":"sketch.rectangle.center","params":{"center":[-34.8, 0.5],"corner":[-33.8,11.5]},"caption":"Heatsink vent L1"},
    {"command":"sketch.rectangle.center","params":{"center":[-37.8, 0.5],"corner":[-36.8,11.5]},"caption":"Heatsink vent L2"},
    {"command":"sketch.rectangle.center","params":{"center":[ 34.8, 0.5],"corner":[ 35.8,11.5]},"caption":"Heatsink vent R1"},
    {"command":"sketch.rectangle.center","params":{"center":[ 37.8, 0.5],"corner":[ 38.8,11.5]},"caption":"Heatsink vent R2"},
    {"comment":"── DC-output end slots (20 mm span, half=10) ──"},
    {"command":"sketch.rectangle.center","params":{"center":[-34.8,-23.5],"corner":[-33.8,-13.5]},"caption":"DC-out vent L1"},
    {"command":"sketch.rectangle.center","params":{"center":[-37.8,-23.5],"corner":[-36.8,-13.5]},"caption":"DC-out vent L2"},
    {"command":"sketch.rectangle.center","params":{"center":[ 34.8,-23.5],"corner":[ 35.8,-13.5]},"caption":"DC-out vent R1"},
    {"command":"sketch.rectangle.center","params":{"center":[ 37.8,-23.5],"corner":[ 38.8,-13.5]},"caption":"DC-out vent R2"},
    {"command":"sketch.finish","params":{}},
    {
      "command":"solid.extrude",
      "params":{"through_all":true,"operation":"cut","body_name":"Lid"},
      "caption":"Cut lid vent slots","pause":0.8
    },

    {"comment":"══ SECTION 12 · REFERENCE BODIES (suppress before printing) ══"},

    {"comment":"── AC-DC2416: 65.6 × 115 mm footprint, centre (0, 24), Z=7.5 to 35.5 ──"},
    {"comment":"XY plane. corner = [centre_x + half_w, centre_y + half_d] = [0+32.8, 24+57.5] = [32.8, 81.5]"},
    {
      "command":"sketch.create",
      "params":{"plane":"XY","name":"Ref_ACDC_Sk"},
      "caption":"AC-DC2416 reference body","pause":0.5
    },
    {
      "command":"sketch.rectangle.center",
      "params":{"center":[0,24],"corner":[32.8,81.5]},
      "caption":"65.6 × 115 mm footprint centred at (0, 24)"
    },
    {"command":"sketch.finish","params":{}},
    {
      "command":"solid.extrude",
      "params":{"distance":28,"offset":7.5,"operation":"new_body","body_name":"Ref_ACDC2416"},
      "caption":"28 mm tall, lifted 7.5 mm (wall+standoff)","pause":0.5
    },

    {"comment":"── XY-SK60X: 86 × 50 mm face, INWARD from front inner face (Y=−86.5) ──"},
    {"comment":"Plane normal must point INWARD (+Y). Use x_dir=[1,0,0], y_dir=[0,0,−1] → normal=[0,1,0]=+Y"},
    {"comment":"Sketch: X=worldX, sketch_Y=−worldZ. Controller worldX=−26.85, worldZ=30.3 → sketch (−26.85, −30.3)"},
    {"comment":"half_w=43(86/2), half_h=25(50/2). corner=[−26.85+43, −30.3+25]=[16.15,−5.3]"},
    {
      "command":"sketch.create",
      "params":{"plane":{"origin":[0,-86.5,0],"x_dir":[1,0,0],"y_dir":[0,0,-1]},"name":"Ref_Ctrl_Sk"},
      "caption":"XY-SK60X reference body (inward extrude)","pause":0.5
    },
    {
      "command":"sketch.rectangle.center",
      "params":{"center":[-26.85,-30.3],"corner":[16.15,-5.3]},
      "caption":"86 × 50 mm face centred at X=−26.85"
    },
    {"command":"sketch.finish","params":{}},
    {
      "command":"solid.extrude",
      "params":{"distance":45,"operation":"new_body","body_name":"Ref_Controller"},
      "caption":"Extrude 45 mm inward (+Y) → Y=−86.5 to −41.5","pause":0.5
    },

    {"comment":"── IEC C14 combo: 58 × 49 mm face, from rear face Y=89 inward (−Y) ──"},
    {"comment":"Plane: origin=[0,89,0], x=[1,0,0], y=[0,0,1] → normal=[0,−1,0]=−Y (inward) ✓"},
    {"comment":"centre=(0,30.3), half=(29,24.5). corner=[0+29, 30.3+24.5]=[29,54.8]"},
    {
      "command":"sketch.create",
      "params":{"plane":{"origin":[0,89,0],"x_dir":[1,0,0],"y_dir":[0,0,1]},"name":"Ref_IEC_Sk"},
      "caption":"IEC C14 combo reference body","pause":0.5
    },
    {
      "command":"sketch.rectangle.center",
      "params":{"center":[0,30.3],"corner":[29,54.8]},
      "caption":"58 × 49 mm face centred at (0, 30.3)"
    },
    {"command":"sketch.finish","params":{}},
    {
      "command":"solid.extrude",
      "params":{"distance":29.5,"operation":"new_body","body_name":"Ref_IEC_C14"},
      "caption":"29.5 mm inward (−Y) → Y=89 to 59.5 — design complete","pause":1.0
    }

  ]
}
